{
  "name": "lark-cli",
  "version": "0.1.2",
  "description": "Use the local Lark CLI for docs, sheets, Base, messages, and calendars.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.png",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
