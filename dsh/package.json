    "lib/index.js",
    "icon.png",
    "README.md",
    "locale"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "feishu",
    "lark",
    "lark-cli",
    "docs",
    "sheets",
    "base",
    "calendar",
    "messaging"
  ],
  "dsh": {
